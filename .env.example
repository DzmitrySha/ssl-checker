# SSL checker settings
SITE_PORT=443

# Язык интерфейса: ru (по умолчанию) или en
LANGUAGE=ru

# Каталог для app_YYYY-MM-DD.log (loguru). Пусто = ./logs рядом с проектом
LOGS_DIR=logs

# Список узлов: запятая и/или новая строка; можно host:8443
SITES_TO_CHECK=google.com,ya.ru
# Путь к файлу со списком (если задан и файл есть — он вместо строки выше)
SITES_FILE=

WARN_DAYS=7
CRITICAL_DAYS=3

SEND_WIN_ALERT=true
WIN_USE_NATIVE_MSGBOX=true

# Сервис уведомлений: POST /api/v1/notifications
SEND_NOTIFICATIONS=true
NOTIFICATION_API_BASE_URL=https://notification.energo.net
NOTIFICATION_CLIENT_SECRET_KEY=
NOTIFICATION_APP_LABEL=sslcheck
NOTIFICATION_USER_IDS=1,2,3
NOTIFICATION_DELIVER_TO_MATTERMOST=true

# TLS при POST на сервис: true = строгая проверка (нужен корневой сертификат издателя, доверенный для Python).
# Ошибка verify → false (только тест) или полный путь к PEM корня вашей организации (центра сертификации).
NOTIFICATION_API_TLS_VERIFY=true

# true / false / path-to-pem-or-crt
TLS_VERIFY=true
TLS_SITE_CHECK_TRUST_ONLY_CAFILE=false
TLS_READ_EXPIRY_ON_VERIFY_FAIL=true

# Режим планировщика: main.py --schedule (Docker по умолчанию)
SCHEDULER_TIMEZONE=Europe/Moscow
DAILY_BATCH_HOUR=9
DAILY_BATCH_MINUTE=0
# Пакет при старте процесса --schedule (локально по умолчанию true в settings.py).
# В docker-compose.yml для сервиса задано RUN_BATCH_ON_START=false — без немедленной проверки при первом подъёме контейнера.
RUN_BATCH_ON_START=true
